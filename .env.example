# ============================================================================
# FinanceRAG — environment template.  Copy to .env and fill in:  cp .env.example .env
# (.env is gitignored; never commit real keys.)
# Load it before running, e.g.:  export $(grep -v '^#' .env | xargs)
# ============================================================================

# --- App answer generation (Streamlit / pipeline) ---------------------------
# Needed only for AI answers; retrieval works without it.
OPENAI_API_KEY=sk-your-openai-key

# Optional model overrides for the app (sensible defaults if unset):
# FINRAG_LLM_MODEL=gpt-4o-mini
# FINRAG_EMBEDDING_MODEL=intfloat/e5-small-v2
# FINRAG_RERANKER_MODEL=BAAI/bge-reranker-v2-m3
# FINRAG_DATA_DIR=data
# FINRAG_CACHE_DIR=.rag_cache

# ============================================================================
# --- LightRAG experiment (scripts/compare_lightrag.py, make_submission --engine lightrag)
# ============================================================================

# LLM for graph extraction (the expensive part). Default = OpenAI gpt-4o-mini.
# CHEAP option: DeepSeek (OpenAI-compatible, ~10x cheaper than gpt-4o-mini).
# Uncomment these three to use DeepSeek for the LLM:
# LIGHTRAG_LLM_BASE_URL=https://api.deepseek.com/v1
# LIGHTRAG_LLM_MODEL=deepseek-chat
# DEEPSEEK_API_KEY=sk-your-deepseek-key
# (If unset, the LLM falls back to OPENAI_API_KEY + gpt-4o-mini.)

# Embeddings for LightRAG. Default = FREE local model (no API cost).
# NOTE: DeepSeek has NO embedding endpoint, so embeddings can't use DeepSeek.
# LIGHTRAG_EMBED=local                       # local (free) | openai
# LIGHTRAG_EMBED_MODEL=BAAI/bge-small-en-v1.5  # local: any sentence-transformers model
#                                              # openai: text-embedding-3-small
